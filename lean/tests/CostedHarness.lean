import Westfall022.Complexity
open Westfall022

def showRes {n : ℕ} (A : WMat n) : String :=
  let c := autoCutCosted A
  match c.val with
  | none => s!"NONE|cost={c.cost}"
  | some r =>
    let v : String := match (r.1 : Option ℚ) with | none => "bot" | some q => toString q
    s!"{v}|{List.ofFn (fun i => (r.2.1 i).val)}|{objective A r.2.1}|{List.ofFn (fun v => (r.2.2.1 v).val)}|{lamB A r.2.2.1}|{r.2.2.2}|{(reachable A r.2.2.2).card}|{(nodes A r.2.2.2).card}|cost={c.cost}"

